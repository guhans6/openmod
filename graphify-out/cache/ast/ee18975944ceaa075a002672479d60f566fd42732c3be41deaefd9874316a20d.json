ait sqliteDone?.promise\n    }\n\n    logger.log(\"spawning sidecar\", { url })\n    const { listener, health } = await spawnLocalServer(hostname, port, password, () => {\n      ensureLoopbackNoProxy()\n      useEnvProxy()\n    })\n    server = listener\n    serverReady.resolve({\n      url,\n      username: \"opencode\",\n      password,\n    })\n\n    await Promise.race([\n      health.wait,\n      delay(30_000).then(() => {\n        throw new Error(\"Sidecar health check timed out\")\n      }),\n    ]).catch((error) => {\n      logger.error(\"sidecar health check failed\", error)\n    })\n\n    logger.log(\"loading task finished\")\n  })", "is_member_call": false, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/main/index.ts", "source_location": "L175"}, {"caller_nid": "main_index_initialize", "callee": "race", "is_member_call": true, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/main/index.ts", "source_location": "L227"}, {"caller_nid": "main_index_initialize", "callee": "then", "is_member_call": true, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/main/index.ts", "source_location": "L227"}, {"caller_nid": "main_index_initialize", "callee": "then", "is_member_call": true, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/main/index.ts", "source_location": "L227"}, {"caller_nid": "main_index_initialize", "callee": "createLoadingWindow", "is_member_call": false, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/main/index.ts", "source_location": "L229"}, {"caller_nid": "main_index_initialize", "callee": "createMainWindow", "is_member_call": false, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/main/index.ts", "source_location": "L241"}, {"caller_nid": "main_index_initialize", "callee": "close", "is_member_call": true, "source_file": "/Users/guhan/Guhan/Proje