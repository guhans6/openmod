) {\n          return api.getLength()\n        },\n      }\n      return api\n    }\n\n    return (name = \"default.dat\") => {\n      const cached = cache.get(name)\n      if (cached) return cached\n      const api = createStorage(name)\n      cache.set(name, api)\n      return api\n    }\n  })", "is_member_call": false, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/renderer/index.tsx", "source_location": "L99"}, {"caller_nid": "renderer_index_loadlocale", "callee": "getItem", "is_member_call": true, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/renderer/index.tsx", "source_location": "L278"}, {"caller_nid": "renderer_index_loadlocale", "callee": "storage", "is_member_call": true, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/renderer/index.tsx", "source_location": "L278"}, {"caller_nid": "renderer_index_loadlocale", "callee": "getItem", "is_member_call": true, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/renderer/index.tsx", "source_location": "L279"}, {"caller_nid": "renderer_index_loadlocale", "callee": "storage", "is_member_call": true, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/renderer/index.tsx", "source_location": "L279"}, {"caller_nid": "renderer_index_loadlocale", "callee": "match", "is_member_call": true, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/renderer/index.tsx", "source_location": "L282"}, {"caller_nid": "renderer_index_loadlocale", "callee": "normalizeLocale", "is_member_call": false, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/renderer/index.tsx", "source_location": "L284"}, {"caller_nid": "renderer_index_loadlocale", "callee": "loadLocaleDict", "is_member_call": false, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/desktop/src/renderer/index.tsx", "source_loc