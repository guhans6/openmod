})\n          if (value !== undefined) return value\n          return migrateLegacy({\n            current,\n            legacyStore,\n            stores: legacyStores,\n            keys: legacy,\n            key,\n            defaults,\n            migrate: config.migrate,\n          })\n        },\n        setItem: (key, value) => {\n          current.setItem(key, value)\n        },\n        removeItem: (key) => {\n          current.removeItem(key)\n        },\n      }\n\n      return api\n    }\n\n    const current = currentStorage as AsyncStorage\n    const legacyStore = legacyStorage as AsyncStorage | undefined\n    const legacyStores = legacyStorageNames\n      .map((name) => platform.storage?.(name) as AsyncStorage | undefined)\n      .filter((x) => !!x)\n\n    const api: AsyncStorage = {\n      getItem: async (key) => {\n        const value = await readCurrentAsync({ storage: current, key, defaults, migrate: config.migrate })\n        if (value !== undefined) return value\n        return migrateLegacyAsync({\n          current,\n          legacyStore,\n          stores: legacyStores,\n          keys: legacy,\n          key,\n          defaults,\n          migrate: config.migrate,\n        })\n      },\n      setItem: async (key, value) => {\n        await current.setItem(key, value)\n      },\n      removeItem: async (key) => {\n        await current.removeItem(key)\n      },\n    }\n\n    return api\n  })", "is_member_call": false, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/app/src/utils/persist.ts", "source_location": "L529"}, {"caller_nid": "utils_persist_persisted", "callee": "makePersisted", "is_member_call": false, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/app/src/utils/persist.ts", "source_location": "L591"}, {"caller_nid": "utils_persist_persisted", "callee": "createResource", "is_member_call": false, "source_file": "/Users/guhan/Guhan/Projects/opencode/opencode/packages/app/src/utils/persist.t